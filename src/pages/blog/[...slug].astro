---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPosts, type BlogPost as BlogPostEntry } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			newerPost: posts[index - 1],
			olderPost: posts[index + 1],
		},
	}));
}
interface Props {
	post: BlogPostEntry;
	newerPost?: BlogPostEntry;
	olderPost?: BlogPostEntry;
}

const { post, newerPost, olderPost } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} id={post.id} newerPost={newerPost} olderPost={olderPost}>
	<Content />
</BlogPost>
